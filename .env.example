# Required to enable the Inspect Hook.
INSPECT_BRIEF_CSV_PATH=results/brief_results.csv

# Optional: show Inspect Brief task and run summaries in the terminal.
INSPECT_LOG_LEVEL=info

# Optional: set to false to disable the hook explicitly.
# INSPECT_BRIEF_ENABLED=false

# Optional: restrict the hook to particular task names.
# INSPECT_BRIEF_TASKS=inspect_evals/hellaswag

# Optional: JSON object or path to a target-metrics JSON file.
# INSPECT_BRIEF_TARGET_METRICS=./target_metrics.json

# Optional: do not append a Run ID already recorded in the CSV.
# INSPECT_BRIEF_SKIP_EXISTING=true
